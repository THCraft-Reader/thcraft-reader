+/* NativeText port: retain the existing breaker/destructor ownership model. */
+ThBrk *
+th_brk_new_from_memory (const uint8_t *data, size_t size)
+{
+    ThBrk *brk = (ThBrk *) malloc (sizeof (ThBrk));
+    if (!brk)
+        return NULL;
+    brk->dict_trie = trie_new_from_memory (data, size);
+    if (!brk->dict_trie) {
+        free (brk);
+        return NULL;
+    }
+    return brk;
+}
