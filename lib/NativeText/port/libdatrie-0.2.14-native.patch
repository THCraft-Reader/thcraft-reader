+        !trie_memory_u32 (r, &count) || count < DA_POOL_BEGIN ||
+        count > INT32_MAX - TRIE_CHAR_MAX ||
+        count > SIZE_MAX / sizeof (DACell) ||
+        count - 1 > (r->size - r->pos) / 8)
+        return NULL;
+    d = (DArray *) malloc (sizeof (DArray));
+    if (!d)
+        return NULL;
+    d->num_cells = (TrieIndex)count;
+    d->cells = (DACell *) malloc ((size_t)count * sizeof (DACell));
+    if (!d->cells) {
