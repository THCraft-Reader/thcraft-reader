+        return NULL;
+    }
+    d->cells[0].base = (TrieIndex)DA_SIGNATURE;
+    d->cells[0].check = d->num_cells;
+    for (i = 1; i < d->num_cells; ++i) {
+        trie_memory_i32 (r, &d->cells[i].base);
+        trie_memory_i32 (r, &d->cells[i].check);
+    }
+    if (d->cells[2].check != 0 || d->cells[2].base < DA_POOL_BEGIN ||
+        d->cells[2].base > INT32_MAX - TRIE_CHAR_MAX)
+        goto fail;
+    for (i = 1; i < d->num_cells; ++i) {
+        TrieIndex base = d->cells[i].base, check = d->cells[i].check;
+        if (i == 2)
+            continue;
