+Tail *
+tail_read_memory (TrieMemoryReader *r, unsigned max_symbol)
+{
+    TrieMemoryReader scan = *r;
+    uint32_t sig, count, first, i;
+    int32_t next, data;
+    size_t length, j;
+    const uint8_t *bytes;
+    Tail *t;
+    if (!trie_memory_u32 (&scan, &sig) || sig != TAIL_SIGNATURE ||
+        !trie_memory_u32 (&scan, &first) ||
+        !trie_memory_u32 (&scan, &count) || count >= INT32_MAX ||
+        count > SIZE_MAX / sizeof (TailBlock) ||
+        count > (scan.size - scan.pos) / 10 ||
+        (first != 0 && first >= count))
+        return NULL;
+    for (i = 0; i < count; ++i) {
+        if (!trie_memory_i32 (&scan, &next) ||
+            !trie_memory_i32 (&scan, &data) ||
+            !trie_memory_length (&scan, &length) ||
+            !trie_memory_bytes (&scan, length, &bytes) ||
+            next < -1 || (next > 0 && ((uint32_t)next >= count ||
+                                      (uint32_t)next <= i)) ||
+            (next != -1 && length != 0))
+            return NULL;
+        for (j = 0; j < length; ++j)
+            if (bytes[j] == TRIE_CHAR_TERM || bytes[j] > max_symbol)
+                return NULL;
+    }
+    t = tail_new ();
+    if (!t)
+        return NULL;
+    if (count) {
+        t->tails = (TailBlock *) calloc (count, sizeof (TailBlock));
+        if (!t->tails)
