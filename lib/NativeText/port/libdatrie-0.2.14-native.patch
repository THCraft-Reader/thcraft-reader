+                -check >= d->num_cells || -base >= d->num_cells ||
+                -check == 2 || -base == 2)
+                goto fail;
+            ++free_count;
+        } else {
+            TrieIndex parent_base;
+            if (i == 1 || check < 2 || check >= d->num_cells ||
+                check == i || base == 0 || base == INT32_MIN ||
+                (base > 0 && (base < DA_POOL_BEGIN ||
+                             base > INT32_MAX - TRIE_CHAR_MAX)))
+                goto fail;
+            parent_base = d->cells[check].base;
+            if (parent_base < DA_POOL_BEGIN || parent_base > i ||
