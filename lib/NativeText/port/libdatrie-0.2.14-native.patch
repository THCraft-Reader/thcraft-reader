+    }
+    t->num_tails = (TrieIndex)count;
+    t->first_free = (TrieIndex)first;
+    r->pos += 12;
+    for (i = 0; i < count; ++i) {
+        trie_memory_i32 (r, &t->tails[i].next_free);
+        trie_memory_i32 (r, &t->tails[i].data);
+        trie_memory_length (r, &length);
+        trie_memory_bytes (r, length, &bytes);
+        if (t->tails[i].next_free == -1) {
+            t->tails[i].suffix = (TrieChar *) malloc (length + 1);
+            if (!t->tails[i].suffix)
+                goto fail;
+            memcpy (t->tails[i].suffix, bytes, length);
+            t->tails[i].suffix[length] = TRIE_CHAR_TERM;
+        }
+    }
+    if (first && t->tails[first].next_free == -1)
+        goto fail;
+    for (i = 0; i < count; ++i)
+        if (t->tails[i].next_free > 0 &&
+            t->tails[t->tails[i].next_free].next_free == -1)
+            goto fail;
+    return t;
+fail:
+    tail_free (t);
+    return NULL;
+}
+
+Bool
